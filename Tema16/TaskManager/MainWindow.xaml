<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="500" Width="800">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddTaskCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditTaskCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteTaskCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5">

            <Button Content="Выйти"
                    Click="Exit_Click"
                    Margin="5"/>
            
            <Button Content="Добавить"
                    Command="{Binding AddTaskCommand}"
                    Margin="5"/>

            <Button Content="Редактировать"
                    Command="{Binding EditTaskCommand}"
                    Margin="5"/>

            <Button Content="Удалить"
                    Command="{Binding DeleteTaskCommand}"
                    Margin="5"/>

            <Separator Width="20"/>

            <Button Content="Открыть чат"
                    Click="OpenChat_Click"
                    Margin="5"/>

            <Button Content="Сменить пользователя"
                    Click="Logout_Click"
                    Margin="5"/>

        </StackPanel>

        <Grid Margin="10">

            <ListBox ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding SelectedTask}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Width="200"/>
                            <TextBlock Text="{Binding Status}" Width="150"/>
                            <TextBlock Text="{Binding Priority}" Width="120"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <Grid Background="#80000000"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Загрузка..."
                               Foreground="White"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <ProgressBar Width="200"
                                 Height="20"
                                 IsIndeterminate="True"/>
                </StackPanel>

            </Grid>

        </Grid>

    </DockPanel>
</Window>