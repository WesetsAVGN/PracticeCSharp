<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="450" Width="700">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddTaskCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditTaskCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteTaskCommand}" />
    </Window.InputBindings>

    <Grid Margin="10">

        <ListBox ItemsSource="{Binding Tasks}"
                 SelectedItem="{Binding SelectedTask}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" Width="150"/>
                        <TextBlock Text="{Binding Status}" Width="120"/>
                        <TextBlock Text="{Binding Priority}" Width="100"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Background="#80000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Загрузка..."
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <ProgressBar Width="200"
                             Height="20"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>