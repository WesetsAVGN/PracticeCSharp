@model List<ExpenseTracker.Models.Expense>

<h2>Список расходов</h2>

@if (TempData["Success"] != null)
{
    <div class="alert">
        @TempData["Success"]
    </div>
}

<style>
    body {
        font-family: Arial;
    }

    .container {
        max-width: 900px;
        margin: 20px auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

    th {
        background-color: #f5f5f5;
        text-align: left;
        padding: 12px;
        border-bottom: 2px solid #ccc;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f9f9f9;
    }

    .alert {
        background-color: #d4edda;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 10px;
        color: #155724;
    }

    .btn {
        display: inline-block;
        padding: 10px 15px;
        margin-top: 15px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
    }

        .btn:hover {
            background-color: #0056b3;
        }

    .filter {
        margin-bottom: 15px;
    }

        .filter input {
            margin-right: 10px;
            padding: 5px;
        }

        .filter button {
            padding: 6px 10px;
        }
</style>

<div class="container">

    <form method="get" action="/Expenses/FilterByDate" class="filter">

        <label>С:</label>
        <input type="date" name="from" />

        <label>По:</label>
        <input type="date" name="to" />

        <button type="submit">Фильтр</button>

        <a href="/Expenses/Index">Сброс</a>

    </form>

    <table>
        <tr>
            <th style="width: 30%">Название</th>
            <th style="width: 20%">Сумма</th>
            <th style="width: 25%">Категория</th>
            <th style="width: 25%">Дата</th>
        </tr>

        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.Amount.ToString("0.00")</td>
                <td>@e.Category</td>
                <td>@e.Date.ToString("dd.MM.yyyy")</td>
            </tr>
        }

    </table>

    <a class="btn" href="/Expenses/Add">Добавить расход</a>

</div>