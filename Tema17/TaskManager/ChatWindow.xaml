<Window x:Class="TaskManager.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Height="350" Width="400">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- СПИСОК СООБЩЕНИЙ -->
        <ListBox x:Name="MessagesBox" />

        <!-- ВВОД -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="MessageInput" Width="250"/>
            <Button Content="Отправить"
                    Click="Send_Click"
                    Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>