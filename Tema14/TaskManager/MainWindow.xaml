<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="450" Width="700">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Задачи">
                <MenuItem Header="Создать" Command="{Binding AddTaskCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать" Command="{Binding EditTaskCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Удалить" Command="{Binding DeleteTaskCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>

            <MenuItem Header="Настройки">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Создать" Command="{Binding AddTaskCommand}"/>
            <Button Content="Редактировать" Command="{Binding EditTaskCommand}"/>
            <Button Content="Удалить" Command="{Binding DeleteTaskCommand}"/>
        </ToolBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ComboBox x:Name="StatusFilter"
                      SelectionChanged="StatusFilter_Changed">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Выполнено"/>
                <ComboBoxItem Content="Отложено"/>
            </ComboBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">

                <TextBox Width="150"
                         Text="{Binding NewTask.Title, Mode=TwoWay}"/>

                <ComboBox Width="120"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding NewTask.Priority, Mode=TwoWay}">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <ComboBox Width="120"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding NewTask.Status, Mode=TwoWay}">
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнено"/>
                    <ComboBoxItem Content="Отложено"/>
                </ComboBox>

                <Button Content="Добавить"
                        Click="Add_Click"
                        Margin="5"/>
            </StackPanel>

            <ListBox Grid.Row="2"
                     ItemsSource="{Binding FilteredTasks}"
                     SelectedItem="{Binding SelectedTask}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Width="150"/>
                            <TextBlock Text="{Binding Status}" Width="120"/>
                            <TextBlock Text="{Binding Priority}" Width="100"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>
    </DockPanel>
</Window>